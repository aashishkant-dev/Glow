+// Empties a session's inputs/outputs on its own native queue before letting
+// go of it — see teardownSession's own comment for the full crash this
+// exists to prevent. Shared by both the "component unmounted while session
+// was still being created" cancel path and the normal unmount teardown path
+// below, since both discard a session object and both need the same
+// protection.
+async function teardownSession(session) {
+    try {
+        // Both stop() and configure() run on HybridCameraSession's own
+        // internal serial queue (Self.queue, "com.margelo.camera.session" —
+        // see ios/Hybrid Objects/HybridCameraSession.swift), the ONLY
+        // thread-safe context AVFoundation allows for touching this
+        // AVCaptureSession. configure([]) with an empty connections array
+        // removes every currently-attached input/output (see its
+        // updateInputs/updateOutputs — an empty target list means every
+        // existing one gets removed) — awaited here so this promise doesn't
+        // resolve (and this session doesn't get treated as fully torn down)
+        // until that's actually finished.
+        await session.stop();
+        await session.configure([]);
+    }
+    catch (error) {
+        console.error('[useCameraSession] failed to stop/empty camera session before releasing it', error);
+    }
+    // dispose() is NOT a substitute for the above — it's a no-op here.
+    // HybridObject's base Swift implementation is `public func dispose() {}`
+    // (react-native-nitro-modules/ios/core/HybridObject.swift), and
+    // HybridCameraSession (react-native-vision-camera's actual Swift class)
+    // never overrides it. A previous version of this patch called
+    // session.dispose() believing it forced synchronous native teardown —
+    // confirmed against the library's own source that it does nothing at
+    // all, camera-session-specific or otherwise.
