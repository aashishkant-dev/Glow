# Glow Backend — Environment Variables
# Copy this file to .env for local development. Railway sets these automatically.

# Set automatically by Railway PostgreSQL plugin — do not set manually on Railway
DATABASE_URL=postgresql://user:password@host:5432/glow

# Authentication
JWT_SECRET=

# Twilio (SMS OTP — Canada/USA)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# NepalOTP (nepalotp.com) — owns full send+verify for +977 numbers; unlike
# Twilio this is not a blind SMS transport, see src/utils/smsProviders/nepalotp.js
NEPALOTP_API_KEY=

# Redis (Upstash — keep as-is)
REDIS_URL=

# Stripe
STRIPE_SECRET_KEY=

# Vercel Blob (document/photo storage)
# Get from: vercel.com → Storage → Blob → your store → .env.local
BLOB_READ_WRITE_TOKEN=

# My Space skin scan — OPTIONAL. Unset = free on-device pixel-math + quiz
# heuristic (src/utils/skinAnalysis.js), $0/scan. Set = real Gemini
# vision-model analysis (src/utils/geminiSkinAnalysis.js), with automatic
# fallback to the free heuristic on any Gemini error. Get a key free at
# aistudio.google.com/apikey (Gemini has a genuinely usable free tier for
# this volume; paid beyond it).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Business rules
HOURLY_RATE=40
NEARBY_RADIUS_KM=15
OTP_TTL_MINUTES=5

# Region — used ONLY as a last-resort map centre when neither the user nor a
# Provider has shared real GPS yet (keeps "nearby" screens from being empty on
# first load). Never used for distance math. Set these to your launch city.
DEFAULT_REGION_LAT=
DEFAULT_REGION_LNG=
DEFAULT_REGION_NAME=

# CORS — comma-separated allowed origins, or leave unset for "*" (also always
# allows any *.glow.app and Vercel preview/prod origin — see src/app.js)
CORS_ORIGIN=

# Admin bootstrap (auto-creates admin on first login if no admin exists)
ADMIN_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# Node
NODE_ENV=production

# Glow marketplace
COMMISSION_RATE=0.18
COMMISSION_MIN=2

# Google Sign-In (Part 4, 2026-07-20 auth overhaul) — OAuth client IDs from
# the Google Cloud Console's OAuth consent screen, one per platform. The
# backend verifies ID tokens against whichever of these are set.
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=

# Sign in with Apple — required alongside Google (App Store guideline 4.8).
# APPLE_BUNDLE_ID is just the iOS bundle id (com.glowbeauty.app), no extra
# Apple Developer setup beyond enabling the "Sign in with Apple" capability
# on that App ID. APPLE_SERVICES_ID only needed if web/Android Apple sign-in
# is added later (a separate Services ID, not the app's bundle id).
APPLE_BUNDLE_ID=com.glowbeauty.app
APPLE_SERVICES_ID=
