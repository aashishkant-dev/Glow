# Backend API base (CareNearby Express/Prisma backend on Railway)
NEXT_PUBLIC_API_URL=https://api.carenearby.app

# Google Analytics 4 measurement ID (gtag.js). Leave unset to disable GA4.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# /admin/dashboard login (env-based MVP gate — separate from the main Admin model)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Long-lived admin JWT used server-side to call GET /leads on the backend.
# Obtain via POST {NEXT_PUBLIC_API_URL}/admin/login with real Admin credentials.
ADMIN_API_TOKEN=
